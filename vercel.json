{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/client-room.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/client-room",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/client-room-admin.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/client-room-admin",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/website-design-darjeeling.html",
      "destination": "/website-design-dubrajpur.html",
      "permanent": true
    },
    {
      "source": "/digital-marketing-darjeeling.html",
      "destination": "/digital-marketing-dubrajpur.html",
      "permanent": true
    },
    {
      "source": "/partner.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog-articles.html",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "my-website-one-kappa-68.vercel.app"
        }
      ],
      "destination": "https://www.digitalagencybychandandas.in/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ai-builder.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/agency-admin-2026.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/agency-control-2026.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/agency-control-2026.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/((?!robots).*)\\.(txt|sql)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/client-demo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/client-demo-room.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo-room/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/CLIENT-ID684273",
      "destination": "/CLIENT-ID684273.html"
    },
    {
      "source": "/CLIENT-ASN-2026-ID684273",
      "destination": "/CLIENT-ASN-2026-ID684273.html"
    },
    {
      "source": "/CLIENT-KOL-2026-ID483921",
      "destination": "/CLIENT-KOL-2026-ID483921.html"
    },
    {
      "source": "/bangla-calendar-app-project-view",
      "destination": "/bangla-calendar-app-project-view.html"
    }
  ]
}
