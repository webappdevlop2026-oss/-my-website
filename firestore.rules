rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null; }


    match /room_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    match /room_live_lcd/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_clients/{clientId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_feature_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /room_files/{fileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_chats/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /room_chat_status/{clientId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }


    match /room_invoices/{invoiceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /room_meetings/{meetingId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /room_approvals/{approvalId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }


    // Virtual CCTV / room presence. This tracks website activity only — no camera or microphone data.
    match /room_presence/{presenceId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
  }
}
